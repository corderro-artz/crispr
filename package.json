{
  "name": "crispr",
  "version": "0.1.0",
  "description": "Lossless SVG to PNG rasterization through headless Chromium",
  "type": "module",
  "bin": {
    "crispr": "./dist/crispr.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:all": "node --test --test-concurrency=1 tests/unit/*.test.ts tests/integration/*.test.ts",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "esbuild": "^0.24.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
